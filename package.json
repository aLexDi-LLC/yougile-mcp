{
  "name": "yougile-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for YouGile task management and analytics. Runs locally via stdio or remotely on Cloudflare Workers.",
  "type": "module",
  "bin": {
    "yougile-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler dev",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["mcp", "yougile", "task-management", "cloudflare-workers"],
  "license": "MIT"
}
