# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Required: YouGile API key
# Get it: open YouGile → press Ctrl+~ → copy the key
# Or via API: POST https://ru.yougile.com/api-v2/auth/keys/get
YOUGILE_API_KEY=your_yougile_api_key_here

# Optional: your YouGile user ID (used by my_tasks when userId is not passed)
# Get it: run list_users tool and find your email
YOUGILE_USER_ID=your_user_id_uuid_here

# Remote mode only (Cloudflare Workers):
# Random secret to protect the /mcp endpoint
# Generate: openssl rand -hex 32
# MCP_AUTH_TOKEN=your_random_secret_here
